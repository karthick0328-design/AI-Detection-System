# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database Configuration
DATABASE_PATH=phishing_detector.db

# Model Paths
MODEL_PATH=models/phishing_detector_model.joblib
METADATA_PATH=models/metadata.json
FEATURES_PATH=models/feature_names.json

# Domain / Reputation Check Configuration (Optional external services)
ENABLE_EXTERNAL_CHECKS=0
DOMAIN_CHECK_TIMEOUT=3.0
